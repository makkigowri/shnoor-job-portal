{
  "name": "shnoor-job-portal-backend",
  "version": "1.0.0",
  "description": "Backend API for Shnoor Job Portal",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:assessments": "node scripts/runAssessmentMigration.js",
    "migrate:assessments-legacy": "node scripts/runLegacyColumnsMigration.js",
    "migrate:assessments-checkfix": "node scripts/runDropLegacyCheckConstraint.js",
    "migrate:ats-automation": "node scripts/runAtsAutomationMigration.js",
    "migrate:ai-interview": "node scripts/runAiInterviewMigration.js",
    "migrate:ai-interview-phase9": "node scripts/runAiInterviewPhase9Migration.js",
    "migrate:technical-interview": "node scripts/runTechnicalInterviewMigration.js",
    "migrate:ats-threshold": "node scripts/runAtsThresholdMigration.js",
    "migrate:multi-resume": "node scripts/runMultiResumeMigration.js",
    "migrate:application-resume": "node scripts/runApplicationResumeMigration.js",
    "migrate:contact-requests": "node scripts/runContactRequestsMigration.js",
    "migrate:resume-files": "node scripts/runResumeFilesMigration.js",
